{
  "name": "@showtrak/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ShowTrak wire-protocol type definitions plus the small amount of runtime infrastructure both apps execute (client <-> server <-> SDK). Consumed as a git submodule at shared/.",
  "license": "AGPL-3.0-only",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "author": {
    "name": "ShowTrak",
    "email": "tom@tkw.bz",
    "url": "https://tkw.bz/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShowTrak/ShowTrak-Protocol.git"
  },
  "bugs": {
    "url": "https://github.com/ShowTrak/ShowTrak-Protocol/issues",
    "email": "tom@tkw.bz"
  },
  "homepage": "https://showtrak.co.uk"
}
