{
  "name": "@showtrak/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ShowTrak wire-protocol type definitions plus the small amount of runtime infrastructure both apps execute (client <-> server <-> SDK). Consumed as a git submodule at shared/.",
  "license": "AGPL-3.0-only",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "scripts": {
    "setup": "npm ci --prefix tooling",
    "build": "node tooling/node_modules/typescript/bin/tsc -p tsconfig.build.json --typeRoots ./tooling/node_modules/@types",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "node tooling/node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node tooling/node_modules/typescript/bin/tsc -p tsconfig.build.json --noEmit --typeRoots ./tooling/node_modules/@types",
    "lint": "node tooling/node_modules/eslint/bin/eslint.js -c tooling/lint.config.mjs .",
    "format": "node tooling/node_modules/prettier/bin/prettier.cjs \"**/*.{js,mjs,cjs,ts,md,json,yml}\" --write",
    "format:check": "node tooling/node_modules/prettier/bin/prettier.cjs \"**/*.{js,mjs,cjs,ts,md,json,yml}\" --check"
  },
  "author": {
    "name": "ShowTrak",
    "email": "tom@tkw.bz",
    "url": "https://tkw.bz/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShowTrak/ShowTrak-Protocol.git"
  },
  "bugs": {
    "url": "https://github.com/ShowTrak/ShowTrak-Protocol/issues",
    "email": "tom@tkw.bz"
  },
  "homepage": "https://showtrak.co.uk"
}
