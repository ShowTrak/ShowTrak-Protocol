{
  "name": "@showtrak/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ShowTrak code: the wire protocol between ShowTrak apps (client <-> server <-> SDK), every app's process-boundary contracts, and the runtime code, Electron main-process helpers and build scripts the desktop apps share. Consumed as a git submodule at shared/.",
  "license": "AGPL-3.0-only",
  "types": "src/index.d.ts",
  "typesVersions": {
    "*": {
      "client": [
        "src/client/index.d.ts"
      ],
      "timers": [
        "src/timers/index.d.ts"
      ],
      "runtime": [
        "dist/runtime/index.d.ts"
      ],
      "common": [
        "dist/common/index.d.ts"
      ],
      "common/*": [
        "dist/common/*.d.ts"
      ],
      "electron-main": [
        "dist/electron-main/index.d.ts"
      ],
      "ui/*": [
        "dist/ui/*.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "./client": {
      "types": "./src/client/index.d.ts"
    },
    "./timers": {
      "types": "./src/timers/index.d.ts"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./common/*": {
      "types": "./dist/common/*.d.ts",
      "default": "./dist/common/*.js"
    },
    "./electron-main": {
      "types": "./dist/electron-main/index.d.ts",
      "default": "./dist/electron-main/index.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "default": "./dist/ui/*.js"
    }
  },
  "scripts": {
    "setup": "npm ci --prefix tooling --ignore-scripts",
    "build": "node tooling/build.js",
    "build:ui": "node tooling/node_modules/typescript/bin/tsc -p tsconfig.build.ui.json --typeRoots ./tooling/node_modules/@types",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "node tooling/node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node tooling/node_modules/typescript/bin/tsc -p tooling/tsconfig.build.json --noEmit && node tooling/node_modules/typescript/bin/tsc -p tsconfig.common.json && node tooling/node_modules/typescript/bin/tsc -p tsconfig.build.ui.json --noEmit --typeRoots ./tooling/node_modules/@types && node tooling/node_modules/typescript/bin/tsc -p type-tests/tsconfig.json && node tooling/node_modules/typescript/bin/tsc -p type-tests/tsconfig.exports.json",
    "test": "npm run build && node --test \"spec/**/*.spec.js\"",
    "lint": "node tooling/node_modules/eslint/bin/eslint.js -c tooling/lint.config.mjs .",
    "format": "node tooling/node_modules/prettier/bin/prettier.cjs \"**/*.{js,mjs,cjs,ts,md,json,yml}\" --write",
    "format:check": "node tooling/node_modules/prettier/bin/prettier.cjs \"**/*.{js,mjs,cjs,ts,md,json,yml}\" --check"
  },
  "author": {
    "name": "ShowTrak",
    "email": "tom@tkw.bz",
    "url": "https://tkw.bz/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShowTrak/ShowTrak-Protocol.git"
  },
  "bugs": {
    "url": "https://github.com/ShowTrak/ShowTrak-Protocol/issues",
    "email": "tom@tkw.bz"
  },
  "homepage": "https://showtrak.co.uk"
}
